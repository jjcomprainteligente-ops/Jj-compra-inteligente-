    "check": "npm run typecheck && npm test",
    "build:web": "expo export --platform web --max-workers 2",
    "build:i18n": "expo export --platform all --output-dir dist-i18n --max-workers 2",
    "verify:i18n": "node scripts/verify-i18n.cjs",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
